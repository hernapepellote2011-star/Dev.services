local function fmtDate(ms)
	return os.date("%d/%m/%Y %H:%M", math.floor((tonumber(ms) or 0) / 1000))
end
local function imageUrl(id)
	id = tostring(id or ""):gsub("%D", "")
	return id ~= "" and ("rbxthumb://type=Asset&id=" .. id .. "&w=420&h=420") or nil
end
local function dateText(d, preview)
	local t = tr("published") .. (preview and tr("now_preview") or fmtDate(d.createdAt))
	if d.editedAt then
		t = t .. "  <font color='#FFB84D'>(" .. tr("edited") .. " " .. fmtDate(d.editedAt) .. ")</font>"
	end
	return t
end

local function reactionBar(parent, order, path, votes)
	votes = type(votes) == "table" and votes or {}
	local bar = mk("Frame", { LayoutOrder = order, Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1 }, parent)
	local function imgBtn(x, rot)
		return mk("ImageButton", { Position = UDim2.fromOffset(x, 2), Size = UDim2.fromOffset(24, 24),
			BackgroundTransparency = 1, ScaleType = Enum.ScaleType.Fit, Image = "", ImageColor3 = Color3.new(1, 1, 1),
			ImageTransparency = 0, Rotation = rot }, bar)
	end
	local likeB = imgBtn(0, ROT_LIKE)
	local likeC = label(bar, { Position = UDim2.fromOffset(28, 0), Size = UDim2.fromOffset(36, 28), Text = "0",
		Font = Enum.Font.GothamMedium, TextSize = 13 })
	local disB = imgBtn(68, ROT_DISLIKE)
	local disC = label(bar, { Position = UDim2.fromOffset(96, 0), Size = UDim2.fromOffset(36, 28), Text = "0",
		Font = Enum.Font.GothamMedium, TextSize = 13 })

	local function render()
		local l, dl = 0, 0
		for _, v in pairs(votes) do
			if v == 1 then
				l = l + 1
			elseif v == -1 then
				dl = dl + 1
			end
		end
		local mine = session.uid and votes[session.uid]
		likeB.Image = (mine == 1) and ICON_LIKE_ON or ICON_LIKE_OFF
		disB.Image = (mine == -1) and ICON_DISLIKE_ON or ICON_DISLIKE_OFF
		likeC.Text = tostring(l)
		disC.Text = tostring(dl)
	end
	render()

	local busy = false
	local function vote(v)
		if busy then
			return
		end
		busy = true
		task.spawn(function()
			if not ensureAuth() then
				notify(tr("t_error"), tr("fb_login_fail"))
				busy = false
				return
			end
			local uid = session.uid
			local prev = votes[uid]
			local new = (prev == v) and nil or v
			votes[uid] = new
			render()
			local code
			if new then
				code = db("PUT", path .. "/" .. uid, new)
			else
				code = db("DELETE", path .. "/" .. uid)
			end
			if code ~= 200 then
				votes[uid] = prev
				render()
				notify(tr("t_error"), tr("vote_fail", tostring(code)))
			end
			busy = false
		end)
	end
	likeB.Activated:Connect(function()
		vote(1)
	end)
	disB.Activated:Connect(function()
		vote(-1)
	end)
	return bar
end

