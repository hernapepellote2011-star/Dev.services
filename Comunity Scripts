local function http(method, url, body, headers)
	if not httpRequest then
		return nil, nil
	end
	local ok, res = pcall(httpRequest, {
		Url = url,
		Method = method,
		Headers = headers or { ["Content-Type"] = "application/json" },
		Body = body,
	})
	if not ok or type(res) ~= "table" then
		return nil, nil
	end
	local data
	pcall(function()
		data = HttpService:JSONDecode(res.Body)
	end)
	return res.StatusCode, data
end

local function ensureAuth()
	if session.idToken and os.time() < session.exp - 120 then
		return true
	end
	if session.refreshToken then
		local code, d = http(
			"POST",
			"https://securetoken.googleapis.com/v1/token?key=" .. API_KEY,
			"grant_type=refresh_token&refresh_token=" .. HttpService:UrlEncode(session.refreshToken),
			{ ["Content-Type"] = "application/x-www-form-urlencoded" }
		)
		if code == 200 and d and d.id_token then
			session.idToken, session.refreshToken, session.uid = d.id_token, d.refresh_token, d.user_id
			session.exp = os.time() + (tonumber(d.expires_in) or 3600)
			saveAuth()
			return true
		end
	end
	local code, d = http(
		"POST",
		"https://identitytoolkit.googleapis.com/v1/accounts:signUp?key=" .. API_KEY,
		HttpService:JSONEncode({ returnSecureToken = true })
	)
	if code == 200 and d and d.idToken then
		session.idToken, session.refreshToken, session.uid = d.idToken, d.refreshToken, d.localId
		session.exp = os.time() + (tonumber(d.expiresIn) or 3600)
		saveAuth()
		return true
	end
	return false
end

-- body puede ser tabla (JSON) o un valor simple (numero)
local function db(method, path, body, query)
	if not ensureAuth() then
		return nil, nil
	end
	local url = DB_URL .. "/" .. path .. ".json?auth=" .. session.idToken .. (query and ("&" .. query) or "")
	local payload
	if body ~= nil then
		payload = type(body) == "table" and HttpService:JSONEncode(body) or tostring(body)
	end
	return http(method, url, payload)
end

