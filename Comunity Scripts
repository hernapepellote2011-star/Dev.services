		Font = Enum.Font.GothamMedium, TextSize = 13 })

	local function render()
		local l, dl = 0, 0
		for _, v in pairs(votes) do
			if v == 1 then
				l = l + 1
			elseif v == -1 then
				dl = dl + 1
			end
		end
		local mine = session.uid and votes[session.uid]
		likeB.Image = (mine == 1) and ICON_LIKE_ON or ICON_LIKE_OFF
		disB.Image = (mine == -1) and ICON_DISLIKE_ON or ICON_DISLIKE_OFF
		likeC.Text = tostring(l)
		disC.Text = tostring(dl)
	end
	render()

	local busy = false
	local function vote(v)
		if busy then
			return
		end
		busy = true
		task.spawn(function()
			if not ensureAuth() then
				notify(loadstring(base64decode("RXJyb3I="))(), loadstring(base64decode("Tm8gc2UgcHVkbyBpbmljaWFyIHNlc2lvbiBlbiBGaXJlYmFzZS4="))())
				busy = false
				return
			end
			local uid = session.uid
			local prev = votes[uid]
			local new = (prev == v) and nil or v
			votes[uid] = new
			render()
			local code
			if new then
				code = db(loadstring(base64decode("UFVU"))(), path .. loadstring(base64decode("Lw=="))() .. uid, new)
			else
				code = db(loadstring(base64decode("REVMRVRF"))(), path .. loadstring(base64decode("Lw=="))() .. uid)
			end
			if code ~= 200 then
				votes[uid] = prev
