			run.Activated:Connect(function()
				if running then
					return
				end
				running = true
				run.Text = tr("running")
				markStat("execs", opts.id)
				local fn, err = loadstring(code)
				if fn then
					notify(tr("direct_execute"), tr("running_msg", tostring(d.name)), 3)
					task.spawn(function()
						local ok, e = pcall(fn)
						if not ok then
							notify(tr("run_error"), tostring(e), 6)
						end
					end)
				else
					notify(tr("script_error"), tostring(err), 6)
				end
				task.delay(1.5, function()
					running = false
					if run.Parent then
						run.Text = tr("direct_execute")
					end
				end)
			end)
		end

		local bar = mk("Frame", { LayoutOrder = 4, Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1 }, card)
		local copy = smallButton(bar, tr("copy_script"), Color3.fromRGB(46, 110, 200), 0, 110)
		copy.Activated:Connect(function()
			local fn = setclipboard or toclipboard
			if fn then
				pcall(fn, code)
				markStat("execs", opts.id)
				notify(tr("copied"), tr("copied_msg", tostring(d.name)), 2)
			else
				notify(tr("unavailable"), tr("no_clipboard"))
			end
		end)
		if d.ownerUid and d.ownerUid == session.uid then
			local edit = smallButton(bar, tr("edit"), Color3.fromRGB(90, 90, 120), 118, 80)
			edit.Activated:Connect(function()
				if opts.onEdit then
					opts.onEdit(d)
				end
			end)
			local del = smallButton(bar, tr("delete"), Color3.fromRGB(180, 55, 60), 206, 120)
			local armed = false
			del.Activated:Connect(function()
				if not armed then
					armed = true
					del.Text = tr("sure_tap")
					task.delay(3, function()
						armed = false
						if del.Parent then
							del.Text = tr("delete")
						end
					end)
					return
				end
				del.Text = tr("deleting")
				task.spawn(function()
					local c = db("DELETE", "scripts/" .. opts.id)
					if c == 200 then
						notify(tr("deleted"), tr("deleted_own"), 3)
						if opts.onDeleted then
							opts.onDeleted()
						end
					else
						notify(tr("t_error"), tr("delete_fail", tostring(c)))
						if del.Parent then
							del.Text = tr("delete")
						end
						armed = false
					end
				end)
			end)
		end
		local rbar = reactionBar(card, 5, "scripts/" .. opts.id .. "/votes", d.votes)
		label(rbar, { Position = UDim2.fromOffset(140, 0), Size = UDim2.new(1, -140, 0, 28),
			Text = tr("views_execs", countTbl(d.views), countTbl(d.execs)),
			TextColor3 = MUTED, TextSize = 11 })
	end
	return card
end

