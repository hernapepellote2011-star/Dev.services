local function fetchCooldown()
	if not ensureAuth() then
		return
	end
	local code, v = db("GET", "users/" .. session.uid .. "/lastPublish")
	if code == 200 then
		lastPublishSec = type(v) == "number" and v / 1000 or nil
	end
end

local loadList

local function clearList()
	for _, c in ipairs(listFrame:GetChildren()) do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
end

renderList = function()
	clearList()
	local q = searchText:lower()
	local arr = {}
	for _, d in ipairs(cache) do
		if q == "" or tostring(d.name or ""):lower():find(q, 1, true)
			or tostring(d.ownerName or ""):lower():find(q, 1, true)
			or tostring(d.ownerDisplay or ""):lower():find(q, 1, true) then
			table.insert(arr, d)
		end
	end
	local keyOf = {
		exec = function(d) return countTbl(d.execs) end,
		views = function(d) return countTbl(d.views) end,
		likes = function(d) return countTbl(d.votes, 1) end,
		dislikes = function(d) return countTbl(d.votes, -1) end,
	}
	local function created(d)
		return tonumber(d.createdAt) or 0
	end
	table.sort(arr, function(a, b)
		if sortMode == "oldest" then
			return created(a) < created(b)
		end
		local k = keyOf[sortMode]
		if k then
			local ka, kb = k(a), k(b)
			if ka ~= kb then
				return ka > kb
			end
		end
		return created(a) > created(b)
	end)
	if #arr == 0 then
		label(listFrame, { Size = UDim2.new(1, 0, 0, 40), TextColor3 = MUTED,
			Text = (#cache == 0) and tr("no_scripts") or tr("no_results") })
	end
	for i, d in ipairs(arr) do
		buildCard(listFrame, d, i, {
			id = d.__id,
			onOpen = function(dd)
				openDetail(dd)
			end,
			onDeleted = function()
				task.spawn(loadList)
			end,
			onEdit = function(dd)
				startEditScript(dd)
			end,
		})
	end
end

loadList = function()
	if loading then
		return
	end
	loading = true
	setLoading(true)
	local started = os.clock()
	local code, data = db("GET", "scripts", nil, "orderBy=%22createdAt%22&limitToLast=" .. LOAD_LIMIT)
	task.wait(math.max(0, 0.8 - (os.clock() - started)))
	if code ~= 200 then
		clearList()
		label(listFrame, { Size = UDim2.new(1, 0, 0, 40), Text = tr("connect_fail", tostring(code)), TextColor3 = Color3.fromRGB(255, 120, 120), TextWrapped = true })
	else
		cache = {}
		for id, d in pairs(type(data) == "table" and data or {}) do
			if type(d) == "table" then
				d.__id = id
				table.insert(cache, d)
			end
		end
		renderList()
	end
	setLoading(false)
	loading = false
end

refreshBtn.Activated:Connect(function()
	task.spawn(function()
		fetchCooldown()
		loadList()
	end)
end)

