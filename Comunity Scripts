			if fn then
				pcall(fn, code)
				markStat("execs", opts.id)
				notify("Copiado", '"' .. tostring(d.name) .. '" copiado al portapapeles.', 2)
			else
				notify("No disponible", "Tu executor no soporta portapapeles.")
