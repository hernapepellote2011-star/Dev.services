task.spawn(function()
	while SpaceHub._window == winRef do
		local r = remaining()
		if r > 0 then
			cooldownLbl:Set(tr("cooldown", r // 3600, (r % 3600) // 60, r % 60))
		else
			cooldownLbl:Set(tr("can_publish"))
		end
		pcall(refreshPreview)
		task.wait(0.5)
	end
end)

task.spawn(function()
	fetchCooldown()
	loadList()
	while SpaceHub._window == winRef do
		pcall(updateActive)
		task.wait(30)
	end
end)
