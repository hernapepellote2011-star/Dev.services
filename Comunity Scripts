-- Devuelve el texto en el idioma activo (si falta, usa ingles y luego espanol)
local function tr(key, ...)
	local s = (STR[LANG] and STR[LANG][key]) or STR.en[key] or STR.es[key] or key
	if select("#", ...) > 0 then
		local ok, r = pcall(string.format, s, ...)
		if ok then
			return r
		end
	end
	return s
end

do
	local FORCE_LANG = nil -- "es", "en", "pt", "fr" o "de" para forzar uno (nil = automatico)
	local PREFER_SYSTEM_LOCALE = false -- true = prioriza el idioma del dispositivo sobre el de Roblox
	local DETECT_DELAY = 3 -- segundos de espera antes de detectar el idioma
	local LocalizationService = game:GetService("LocalizationService")

	local function detect()
		local forced = FORCE_LANG or (getgenv and getgenv().SpaceHubLang)
		if forced and STR[tostring(forced):lower()] then
			return tostring(forced):lower(), nil
		end
		local sources = {
			function() return LocalizationService.RobloxLocaleId end,
			function() return me.LocaleId end,
			function() return LocalizationService.SystemLocaleId end,
		}
		if PREFER_SYSTEM_LOCALE then
			sources = { sources[3], sources[1], sources[2] }
		end
		for _, get in ipairs(sources) do
			local ok, id = pcall(get)
			if ok and type(id) == "string" and id ~= "" then
				local code = id:lower():match("^(%a+)")
				if code then
					return STR[code] and code or "en", id
				end
			end
		end
		return "es", nil
	end

	notify("Space Hub", "Detectando idioma... / Detecting language...", DETECT_DELAY)
	task.wait(DETECT_DELAY)
	local lang, rawId = detect()
	LANG = lang
	notify(tr("lang_title"), tr("lang_detected", tr("lang_name") .. (rawId and (" (" .. rawId .. ")") or "")), 3)
end


local AUTH_FILE = "SpaceHub/Community_Auth.json"
local session = { exp = 0 }

local function saveAuth()
	pcall(function()
		if isfolder and makefolder and not isfolder("SpaceHub") then
			makefolder("SpaceHub")
		end
		writefile(AUTH_FILE, HttpService:JSONEncode({ refreshToken = session.refreshToken }))
	end)
end

pcall(function()
	if isfile and isfile(AUTH_FILE) then
		session.refreshToken = HttpService:JSONDecode(readfile(AUTH_FILE)).refreshToken
	end
end)

local function http(method, url, body, headers)
	if not httpRequest then
		return nil, nil
	end
	local ok, res = pcall(httpRequest, {
		Url = url,
		Method = method,
		Headers = headers or { ["Content-Type"] = "application/json" },
		Body = body,
	})
	if not ok or type(res) ~= "table" then
		return nil, nil
	end
	local data
	pcall(function()
		data = HttpService:JSONDecode(res.Body)
	end)
	return res.StatusCode, data
end

local function ensureAuth()
	if session.idToken and os.time() < session.exp - 120 then
		return true
	end
	if session.refreshToken then
		local code, d = http(
			"POST",
			"https://securetoken.googleapis.com/v1/token?key=" .. API_KEY,
			"grant_type=refresh_token&refresh_token=" .. HttpService:UrlEncode(session.refreshToken),
			{ ["Content-Type"] = "application/x-www-form-urlencoded" }
		)
		if code == 200 and d and d.id_token then
			session.idToken, session.refreshToken, session.uid = d.id_token, d.refresh_token, d.user_id
			session.exp = os.time() + (tonumber(d.expires_in) or 3600)
			saveAuth()
			return true
		end
	end
	local code, d = http(
		"POST",
		"https://identitytoolkit.googleapis.com/v1/accounts:signUp?key=" .. API_KEY,
		HttpService:JSONEncode({ returnSecureToken = true })
	)
	if code == 200 and d and d.idToken then
		session.idToken, session.refreshToken, session.uid = d.idToken, d.refreshToken, d.localId
		session.exp = os.time() + (tonumber(d.expiresIn) or 3600)
		saveAuth()
		return true
	end
	return false
end

local function db(method, path, body, query)
	if not ensureAuth() then
		return nil, nil
	end
	local url = DB_URL .. "/" .. path .. ".json?auth=" .. session.idToken .. (query and ("&" .. query) or "")
	local payload
	if body ~= nil then
		payload = type(body) == "table" and HttpService:JSONEncode(body) or tostring(body)
	end
	return http(method, url, payload)
end

