		end,
	})

	-- 3) Chat debajo de todo
	label(detailFrame, { LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 24), Text = "Chat de este script",
		Font = Enum.Font.GothamBold, TextSize = 14 })
	local chatList = mk("Frame", { LayoutOrder = 4, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1 }, detailFrame)
	mk("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, chatList)

	local editRow = mk("Frame", { LayoutOrder = 5, Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1,
		Visible = false }, detailFrame)
	label(editRow, { Size = UDim2.new(1, -100, 1, 0), Text = "Editando tu mensaje...", TextColor3 = Color3.fromRGB(255, 184, 77) })
	local cancelEdit = smallButton(editRow, "Cancelar", Color3.fromRGB(90, 90, 120), 0, 90)
	cancelEdit.AnchorPoint = Vector2.new(1, 0)
	cancelEdit.Position = UDim2.new(1, 0, 0, 0)

	local inputRow = mk("Frame", { LayoutOrder = 6, Size = UDim2.new(1, 0, 0, 38), BackgroundTransparency = 1 }, detailFrame)
	local box = mk("TextBox", { Size = UDim2.new(1, -92, 1, 0), BackgroundColor3 = BG2, BorderSizePixel = 0,
		Text = "", PlaceholderText = "Escribe un mensaje (max. 300)", PlaceholderColor3 = MUTED, TextColor3 = TXT,
		Font = Enum.Font.Gotham, TextSize = 13, ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.None }, inputRow)
	round(box, 8)
	mk("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, box)
	local send = smallButton(inputRow, "Enviar", Color3.fromRGB(46, 110, 200), 0, 84)
	send.AnchorPoint = Vector2.new(1, 0)
	send.Position = UDim2.new(1, 0, 0, 0)
	send.Size = UDim2.fromOffset(84, 38)

	local editingChatId
	local chatLoading = false
	local chatSig
	local sending = false
	local lastSend = 0

	local function startEditChat(m)
		editingChatId = m.__id
		box.Text = tostring(m.text or "")
		editRow.Visible = true
	end
	cancelEdit.Activated:Connect(function()
		editingChatId = nil
		box.Text = ""
		editRow.Visible = false
	end)

	local function loadChat(force)
		if chatLoading or currentSid ~= sid or not chatList.Parent then
			return
		end
		chatLoading = true
		local code, data = db("GET", "chat/" .. sid, nil, "orderBy=%22createdAt%22&limitToLast=60")
		if code == 200 and currentSid == sid and chatList.Parent then
			local arr = {}
			for id, m in pairs(type(data) == "table" and data or {}) do
				if type(m) == "table" then
					m.__id = id
					table.insert(arr, m)
				end
			end
			table.sort(arr, function(a, b)
				return (tonumber(a.createdAt) or 0) < (tonumber(b.createdAt) or 0)
			end)
			local parts = {}
			for _, m in ipairs(arr) do
				local l, dl = 0, 0
				for _, v in pairs(type(m.votes) == "table" and m.votes or {}) do
					if v == 1 then
						l = l + 1
					else
						dl = dl + 1
					end
				end
				table.insert(parts, m.__id .. tostring(m.text) .. tostring(m.editedAt or "") .. l .. ":" .. dl)
			end
			local sig = table.concat(parts, "|")
			if force or sig ~= chatSig then
				chatSig = sig
				for _, c in ipairs(chatList:GetChildren()) do
					if c:IsA("GuiObject") then
						c:Destroy()
					end
				end
				if #arr == 0 then
					label(chatList, { Size = UDim2.new(1, 0, 0, 28), Text = "Aun no hay mensajes. Escribe el primero.",
						TextColor3 = MUTED })
				end
				for i, m in ipairs(arr) do
					buildChatCard(chatList, m, i, sid, startEditChat)
				end
			end
		end
		chatLoading = false
	end

	send.Activated:Connect(function()
		if sending then
			return
		end
		local text = box.Text:gsub("^%s+", ""):gsub("%s+$", "")
		if text == "" then
			return notify("Mensaje vacio", "Escribe algo primero.")
		end
		if #text > 300 then
			return notify("Muy largo", "Maximo 300 caracteres.")
		end
		if not editingChatId and os.clock() - lastSend < 3 then
			return notify("Espera", "Envia mensajes con 3 segundos de diferencia.", 2)
		end
		sending = true
		task.spawn(function()
			if not ensureAuth() then
				sending = false
				return notify("Error", "No se pudo iniciar sesion en Firebase.")
			end
			local code
			if editingChatId then
				local id = editingChatId
				code = db("PATCH", "", {
					["chat/" .. sid .. "/" .. id .. "/text"] = text,
					["chat/" .. sid .. "/" .. id .. "/editedAt"] = NOW,
				})
			else
				local id = HttpService:GenerateGUID(false)
				code = db("PUT", "chat/" .. sid .. "/" .. id, {
					text = text, ownerUid = session.uid, ownerName = me.Name, ownerDisplay = me.DisplayName,
					ownerUserId = me.UserId, createdAt = NOW,
				})
				lastSend = os.clock()
			end
			if code == 200 then
				editingChatId = nil
				editRow.Visible = false
				box.Text = ""
				loadChat(true)
			else
				notify("Error", "No se pudo enviar/editar (codigo " .. tostring(code) .. ").", 5)
			end
			sending = false
		end)
	end)

	task.spawn(function()
		loadChat(true)
		while SpaceHub._window == winRef and currentSid == sid do
			task.wait(6)
			pcall(loadChat, false)
		end
	end)
end

----------------------------------------------------------------------
-- CREAR / EDITAR SCRIPT
----------------------------------------------------------------------
Create:CreateSection("Nuevo script")
local cooldownLbl = Create:CreateLabel("Comprobando...")
local editLbl = Create:CreateLabel("No estas editando ningun script")

local nameIn = Create:CreateInput({ Name = "Nombre", PlaceholderText = "Max. 50 caracteres", CurrentValue = "" })
local imgIn = Create:CreateInput({ Name = "ID de imagen", PlaceholderText = "Ej: 1234567890", CurrentValue = "" })
local codeIn = Create:CreateCodeInput({ Name = "Texto del script", Height = 200, PlaceholderText = "Pega tu script aqui..." })

Create:CreateSection("Vista previa")
local previewFrame = mk("Frame", { LayoutOrder = Create._nextOrder(), Size = UDim2.new(1, 0, 0, 0),
	AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1 }, Create.Page)
mk("UIListLayout", {}, previewFrame)

local function currentForm()
	local n = tostring(nameIn.CurrentValue or ""):gsub("^%s+", ""):gsub("%s+$", "")
	return {
		name = n:sub(1, 50),
		imageId = (tostring(imgIn.CurrentValue or ""):gsub("%D", "")):sub(1, 20),
		script = codeIn:Get() or "",
	}
end

local lastSig
local function refreshPreview()
	local f = currentForm()
	local sig = f.name .. "|" .. f.imageId .. "|" .. #f.script .. "|" .. f.script:sub(1, 400)
	if sig == lastSig then
		return
	end
	lastSig = sig
	for _, c in ipairs(previewFrame:GetChildren()) do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	f.ownerName, f.ownerDisplay, f.ownerUserId = me.Name, me.DisplayName, me.UserId
	buildCard(previewFrame, f, 1, { preview = true })
end

local function remaining()
	if not lastPublishSec then
		return 0
	end
	return math.max(0, math.floor(lastPublishSec + COOLDOWN - os.time()))
end

local function formError(f)
	if f.name == "" then
		return "Falta el nombre", "Escribe un nombre para tu script."
	end
	if f.script:gsub("%s", "") == "" then
		return "Falta el script", "Pega el texto del script."
	end
	if #f.script < 10 or not hasRealCode(f.script) then
		return "Script invalido", "Debe tener codigo ejecutable real. No se aceptan solo comentarios ni letras sueltas."
	end
	if #f.script > 50000 then
		return "Muy largo", "El script no puede superar 50.000 caracteres."
	end
end

local editingScriptId
local function clearForm()
	nameIn:Set("")
	imgIn:Set("")
	codeIn:Set("")
end

startEditScript = function(d)
	editingScriptId = d.__id
	nameIn:Set(tostring(d.name or ""))
	imgIn:Set(tostring(d.imageId or ""))
	codeIn:Set(tostring(d.script or ""))
	editLbl:Set('Editando: "' .. tostring(d.name) .. '" - pulsa "Guardar edicion"')
	notify("Modo edicion", 'Ve a "Crear script", cambia lo que quieras y pulsa "Guardar edicion".', 5)
end

local publishing = false
Create:CreateButton({
	Name = "Publicar script",
	Callback = function()
		if publishing then
			return
		end
		if editingScriptId then
			return notify("Estas editando", "Guarda o cancela la edicion antes de publicar uno nuevo.")
		end
		local f = currentForm()
		local et, em = formError(f)
		if et then
			return notify(et, em)
		end
		if remaining() > 0 then
			return notify("Espera", "Aun no pasaron 24 horas desde tu ultimo script.")
		end
		publishing = true
		task.spawn(function()
			if not ensureAuth() then
				publishing = false
				return notify("Error", "No se pudo iniciar sesion en Firebase. Revisa API_KEY y que Authentication > Anonimo este activado.", 6)
			end
			local id = HttpService:GenerateGUID(false)
			local code = db("PATCH", "", {
				["scripts/" .. id] = {
					name = f.name, script = f.script, imageId = f.imageId,
					ownerUid = session.uid, ownerName = me.Name, ownerDisplay = me.DisplayName,
					ownerUserId = me.UserId, createdAt = NOW,
				},
				["users/" .. session.uid .. "/lastPublish"] = NOW,
			})
			if code == 200 then
				notify("Publicado", "Tu script ya esta en la comunidad.", 4)
				clearForm()
				fetchCooldown()
				loadList()
			else
				notify("No se pudo publicar", "Codigo " .. tostring(code) .. ". Puede que no hayan pasado 24 h o las reglas lo rechazaron.", 6)
			end
			publishing = false
		end)
	end,
})

Create:CreateButton({
	Name = "Guardar edicion",
	Callback = function()
		if publishing then
			return
		end
		if not editingScriptId then
			return notify("Sin edicion", 'Pulsa "Editar" en uno de tus scripts primero.')
		end
		local f = currentForm()
		local et, em = formError(f)
		if et then
			return notify(et, em)
		end
		publishing = true
		task.spawn(function()
			local id = editingScriptId
			local code = db("PATCH", "", {
				["scripts/" .. id .. "/name"] = f.name,
				["scripts/" .. id .. "/script"] = f.script,
				["scripts/" .. id .. "/imageId"] = f.imageId,
				["scripts/" .. id .. "/editedAt"] = NOW,
			})
			if code == 200 then
				notify("Editado", "Tu script se actualizo.", 4)
				editingScriptId = nil
				editLbl:Set("No estas editando ningun script")
				clearForm()
				loadList()
			else
				notify("No se pudo editar", "Codigo " .. tostring(code) .. ". Solo puedes editar tus propios scripts.", 6)
			end
			publishing = false
		end)
	end,
})

Create:CreateButton({
	Name = "Cancelar edicion",
	Callback = function()
		if editingScriptId then
			editingScriptId = nil
			editLbl:Set("No estas editando ningun script")
			clearForm()
		end
	end,
})

