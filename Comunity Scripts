local function http(method, url, body, headers)
	if not httpRequest then
		return nil, nil
	end
	local ok, res = pcall(httpRequest, {
		Url = url,
		Method = method,
		Headers = headers or { [loadstring(base64decode("Q29udGVudC1UeXBl"))()] = loadstring(base64decode("YXBwbGljYXRpb24vanNvbg=="))() },
		Body = body,
	})
	if not ok or type(res) ~= loadstring(base64decode("dGFibGU="))() then
		return nil, nil
	end
	local data
	pcall(function()
		data = HttpService:JSONDecode(res.Body)
	end)
	return res.StatusCode, data
end

local function ensureAuth()
	if session.idToken and os.time() < session.exp - 120 then
		return true
	end
	if session.refreshToken then
		local code, d = http(
			loadstring(base64decode("UE9TVA=="))(),
			loadstring(base64decode("aHR0cHM6Ly9zZWN1cmV0b2tlbi5nb29nbGVhcGlzLmNvbS92MS90b2tlbj9rZXk9"))() .. API_KEY,
			loadstring(base64decode("Z3JhbnRfdHlwZT1yZWZyZXNoX3Rva2VuJnJlZnJlc2hfdG9rZW49"))() .. HttpService:UrlEncode(session.refreshToken),
			{ [loadstring(base64decode("Q29udGVudC1UeXBl"))()] = loadstring(base64decode("YXBwbGljYXRpb24veC13d3ctZm9ybS11cmxlbmNvZGVk"))() }
		)
		if code == 200 and d and d.id_token then
			session.idToken, session.refreshToken, session.uid = d.id_token, d.refresh_token, d.user_id
			session.exp = os.time() + (tonumber(d.expires_in) or 3600)
			saveAuth()
			return true
		end
	end
	local code, d = http(
		loadstring(base64decode("UE9TVA=="))(),
		loadstring(base64decode("aHR0cHM6Ly9pZGVudGl0eXRvb2xraXQuZ29vZ2xlYXBpcy5jb20vdjEvYWNjb3VudHM6c2lnblVwP2tleT0="))() .. API_KEY,
		HttpService:JSONEncode({ returnSecureToken = true })
	)
	if code == 200 and d and d.idToken then
		session.idToken, session.refreshToken, session.uid = d.idToken, d.refreshToken, d.localId
		session.exp = os.time() + (tonumber(d.expiresIn) or 3600)
		saveAuth()
		return true
	end
	return false
end

