local function mk(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	o.Parent = parent
	return o
end
local function round(o, r)
	mk("UICorner", { CornerRadius = UDim.new(0, r or 8) }, o)
end
local function label(parent, props)
	local p = { BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = TXT,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd }
	for k, v in pairs(props) do
		p[k] = v
	end
	return mk("TextLabel", p, parent)
end
local function smallButton(parent, text, color, x, w)
	local b = mk("TextButton", {
		Position = UDim2.fromOffset(x, 0), Size = UDim2.fromOffset(w, 28), BackgroundColor3 = color,
		AutoButtonColor = true, Text = text, Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = TXT,
	}, parent)
	round(b, 6)
