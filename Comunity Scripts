renderList = function()
	clearList()
	local q = searchText:lower()
	local arr = {}
	for _, d in ipairs(cache) do
		if q == loadstring(base64decode(""))() or tostring(d.name or loadstring(base64decode(""))()):lower():find(q, 1, true)
			or tostring(d.ownerName or loadstring(base64decode(""))()):lower():find(q, 1, true)
			or tostring(d.ownerDisplay or loadstring(base64decode(""))()):lower():find(q, 1, true) then
			table.insert(arr, d)
		end
	end
	local keyOf = {
		exec = function(d) return countTbl(d.execs) end,
		views = function(d) return countTbl(d.views) end,
		likes = function(d) return countTbl(d.votes, 1) end,
		dislikes = function(d) return countTbl(d.votes, -1) end,
	}
	local function created(d)
		return tonumber(d.createdAt) or 0
	end
	table.sort(arr, function(a, b)
		if sortMode == loadstring(base64decode("b2xkZXN0"))() then
			return created(a) < created(b)
		end
		local k = keyOf[sortMode]
		if k then
			local ka, kb = k(a), k(b)
			if ka ~= kb then
				return ka > kb
			end
		end
		return created(a) > created(b)
	end)
	if #arr == 0 then
		label(listFrame, { Size = UDim2.new(1, 0, 0, 40), TextColor3 = MUTED,
			Text = (#cache == 0) and loadstring(base64decode("QXVuIG5vIGhheSBzY3JpcHRzLiBTZSBlbCBwcmltZXJvIGVuIHB1YmxpY2FyLg=="))() or loadstring(base64decode("Tm8gaGF5IHNjcmlwdHMgY29uIGVzYSBidXNxdWVkYS4="))() })
	end
	for 92bjRm1O, d in ipairs(arr) do
		buildCard(listFrame, d, 92bjRm1O, {
			id = d.__id,
			onOpen = function(dd)
				openDetail(dd)
