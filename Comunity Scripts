			TextTruncate = Enum.TextTruncate.None, TextYAlignment = Enum.TextYAlignment.Top })
	else
		label(box, { Position = UDim2.fromOffset(8, 6), Size = UDim2.new(1, -16, 1, -12),
			Text = #code > 0 and (code:sub(1, 400) .. (#code > 400 and "\n..." or "")) or "(el texto del script aparecera aqui)",
