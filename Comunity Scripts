						end
					end)
				else
					notify("Error en el script", tostring(err), 6)
				end
				task.delay(1.5, function()
					running = false
					if run.Parent then
						run.Text = "Direct execute"
					end
				end)
			end)
		end

		local bar = mk("Frame", { LayoutOrder = 4, Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1 }, card)
		local copy = smallButton(bar, "Copiar script", Color3.fromRGB(46, 110, 200), 0, 110)
		copy.Activated:Connect(function()
