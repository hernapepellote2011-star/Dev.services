	currentSid = sid
	header.Visible = false
	toolbar.Visible = false
	task.delay(30, function()
		if currentSid == sid then
			markStat("views", sid)
		end
	end)
	listFrame.Visible = false
	for _, c in ipairs(detailFrame:GetChildren()) do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	detailFrame.Visible = true

	-- 1) Volver
	local backRow = mk("Frame", { LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 32), BackgroundTransparency = 1 }, detailFrame)
	local back = smallButton(backRow, "< Volver", BG, 0, 100)
	back.Size = UDim2.fromOffset(100, 32)
	back.Activated:Connect(function()
		closeDetail()
	end)

	-- 2) La pagina completa del script
	buildCard(detailFrame, d, 2, {
		id = sid,
		full = true,
		onDeleted = function()
			closeDetail()
			task.spawn(loadList)
		end,
