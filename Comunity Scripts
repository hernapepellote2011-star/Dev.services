					opts.onEdit(d)
				end
			end)
			local del = smallButton(bar, "Eliminar", Color3.fromRGB(180, 55, 60), 206, 120)
			local armed = false
			del.Activated:Connect(function()
				if not armed then
					armed = true
					del.Text = "Seguro? Toca otra vez"
					task.delay(3, function()
						armed = false
						if del.Parent then
							del.Text = "Eliminar"
						end
					end)
					return
				end
				del.Text = "Eliminando..."
				local c = db("DELETE", "scripts/" .. opts.id)
				if c == 200 then
					notify("Eliminado", "Tu script fue eliminado.", 3)
					if opts.onDeleted then
						opts.onDeleted()
					end
				else
					notify("Error", "No se pudo eliminar (codigo " .. tostring(c) .. ").")
					del.Text = "Eliminar"
					armed = false
				end
			end)
		end
		local rbar = reactionBar(card, 5, "scripts/" .. opts.id .. "/votes", d.votes)
