-- Iconos de like/dislike. true = se cargan como miniatura (sirve con ID de imagen o de Decal);
-- false = rbxassetid directo (solo sirve con ID de imagen)
local ICON_AS_THUMB = true
local function iconUrl(tex)
	local id = tostring(tex):gsub("%D", "")
	if ICON_AS_THUMB then
		return "rbxthumb://type=Asset&id=" .. id .. "&w=150&h=150"
	end
	return "rbxassetid://" .. id
end
local ICON_LIKE_OFF, ICON_LIKE_ON = iconUrl(TEX_LIKE_OFF), iconUrl(TEX_LIKE_ON)
local ICON_DISLIKE_OFF, ICON_DISLIKE_ON = iconUrl(TEX_DISLIKE_OFF), iconUrl(TEX_DISLIKE_ON)

-- Precarga los 4 iconos para que al votar cambien al instante
task.spawn(function()
	local list = {}
	for _, u in ipairs({ ICON_LIKE_OFF, ICON_LIKE_ON, ICON_DISLIKE_OFF, ICON_DISLIKE_ON }) do
		local im = Instance.new("ImageLabel")
		im.Image = u
		table.insert(list, im)
	end
	pcall(function()
		ContentProvider:PreloadAsync(list)
	end)
end)

