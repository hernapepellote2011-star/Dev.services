local spin
local function setLoading(on)
	if on then
		ring.Rotation = 0
		spin = TweenService:Create(ring, TweenInfo.new(0.7, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1),
			{ Rotation = 360 })
		spin:Play()
		status.Text = "Actualizando..."
	else
		if spin then
			spin:Cancel()
		end
		ring.Rotation = ring.Rotation % 360
		local t = TweenService:Create(ring, TweenInfo.new(0.45, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
			{ Rotation = 360 })
		t:Play()
		t.Completed:Connect(function()
			ring.Rotation = 0
		end)
		status.Text = "Actualizar"
	end
end

