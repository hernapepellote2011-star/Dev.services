-- Cuenta entradas de una tabla (views / execs) o votos con valor v
local function countTbl(t, v)
	local n = 0
	if type(t) == "table" then
		for _, x in pairs(t) do
			if v == nil or x == v then
				n = n + 1
			end
		end
	end
	return n
end

