		imageId = (tostring(imgIn.CurrentValue or ""):gsub("%D", "")):sub(1, 20),
		script = codeIn:Get() or "",
	}
end

local lastSig
local function refreshPreview()
	local f = currentForm()
	local sig = f.name .. "|" .. f.imageId .. "|" .. #f.script .. "|" .. f.script:sub(1, 400)
	if sig == lastSig then
		return
	end
	lastSig = sig
	for _, c in ipairs(previewFrame:GetChildren()) do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	f.ownerName, f.ownerDisplay, f.ownerUserId = me.Name, me.DisplayName, me.UserId
	buildCard(previewFrame, f, 1, { preview = true })
end

local function remaining()
	if not lastPublishSec then
		return 0
	end
	return math.max(0, math.floor(lastPublishSec + COOLDOWN - os.time()))
end

local function formError(f)
	if f.name == "" then
		return tr("err_no_name"), tr("err_no_name_d")
	end
	if f.script:gsub("%s", "") == "" then
		return tr("err_no_script"), tr("err_no_script_d")
	end
	if #f.script < 10 or not hasRealCode(f.script) then
		return tr("err_invalid"), tr("err_invalid_d")
	end
	if #f.script > 50000 then
		return tr("too_long"), tr("err_too_long_d")
	end
end

local editingScriptId
local function clearForm()
	nameIn:Set("")
	imgIn:Set("")
	codeIn:Set("")
end

startEditScript = function(d)
	editingScriptId = d.__id
	nameIn:Set(tostring(d.name or ""))
	imgIn:Set(tostring(d.imageId or ""))
	codeIn:Set(tostring(d.script or ""))
	editLbl:Set(tr("editing_label", tostring(d.name)))
	notify(tr("edit_mode"), tr("edit_mode_msg"), 5)
end

local publishing = false
Create:CreateButton({
	Name = tr("btn_publish"),
	Callback = function()
		if publishing then
			return
		end
		if editingScriptId then
			return notify(tr("already_editing"), tr("already_editing_d"))
		end
		local f = currentForm()
		local et, em = formError(f)
		if et then
			return notify(et, em)
		end
		if remaining() > 0 then
			return notify(tr("wait_t"), tr("wait_24h"))
		end
		publishing = true
		task.spawn(function()
			if not ensureAuth() then
				publishing = false
				return notify(tr("t_error"), tr("fb_login_fail_long"), 6)
			end
			local id = HttpService:GenerateGUID(false)
			local code = db("PATCH", "", {
				["scripts/" .. id] = {
					name = f.name, script = f.script, imageId = f.imageId,
					ownerUid = session.uid, ownerName = me.Name, ownerDisplay = me.DisplayName,
					ownerUserId = me.UserId, createdAt = NOW,
				},
				["users/" .. session.uid .. "/lastPublish"] = NOW,
			})
			if code == 200 then
				notify(tr("published_t"), tr("published_d"), 4)
				clearForm()
				fetchCooldown()
				loadList()
			else
				notify(tr("publish_fail"), tr("publish_fail_d", tostring(code)), 6)
			end
			publishing = false
		end)
	end,
})

Create:CreateButton({
	Name = tr("btn_save_edit"),
	Callback = function()
		if publishing then
			return
		end
		if not editingScriptId then
			return notify(tr("no_edit"), tr("no_edit_d"))
		end
		local f = currentForm()
		local et, em = formError(f)
		if et then
			return notify(et, em)
		end
		publishing = true
		task.spawn(function()
			local id = editingScriptId
			local code = db("PATCH", "", {
				["scripts/" .. id .. "/name"] = f.name,
				["scripts/" .. id .. "/script"] = f.script,
				["scripts/" .. id .. "/imageId"] = f.imageId,
				["scripts/" .. id .. "/editedAt"] = NOW,
			})
			if code == 200 then
				notify(tr("edited_t"), tr("edited_d"), 4)
				editingScriptId = nil
				editLbl:Set(tr("not_editing"))
				clearForm()
				loadList()
			else
				notify(tr("edit_fail"), tr("edit_fail_d", tostring(code)), 6)
			end
			publishing = false
		end)
	end,
})

Create:CreateButton({
	Name = tr("btn_cancel_edit"),
	Callback = function()
		if editingScriptId then
			editingScriptId = nil
			editLbl:Set(tr("not_editing"))
			clearForm()
		end
	end,
})

