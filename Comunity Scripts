	end)
end

-- Igual que las reglas de Firebase: debe haber al menos una linea de codigo real (no solo comentarios / letras)
local function hasRealCode(code)
	code = tostring(code or "")
	code = code:gsub("%-%-%[(=*)%[.-%]%1%]", "")
	code = code:gsub("%-%-[^\n]*", "")
	for line in code:gmatch("[^\n]+") do
		local l = line:gsub("^%s+", "")
		if l:match("^local%s+[%a_]") or l:match("^function[%s(]") or l:match("^if[%s(]")
			or l:match("^while[%s(]") or l:match("^for[%s(]") or l:match("^repeat%f[%W]")
			or l:match("^return[%s(]") or l:match("^[%a_][%w_%.:%[%]]*%s*[=(]") then
			return true
		end
	end
	return false
end

